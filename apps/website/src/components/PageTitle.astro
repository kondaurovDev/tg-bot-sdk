---
const fullTitle = Astro.locals.starlightRoute.entry.data.title;
const displayTitle = fullTitle
  .replace(/ – Telegram Bot API Type$/, "")
  .replace(/ – Telegram Bot API$/, "");
---

<h1 id="_top">{displayTitle}</h1>

<script>
  // Defines <tg-api-runner>, the "try it" widget on the API method pages;
  // Astro bundles it once, and it wakes up only where the tag appears
  import "../api-runner"
</script>

<style>
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }
</style>
