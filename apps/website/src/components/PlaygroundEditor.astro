<!-- Editor pane: searchable example picker on top, Monaco below -->
<div class="min-w-0 overflow-hidden flex flex-col" :style="`width: ${editorWidth}%`">
  <div class="flex items-center gap-2 px-2 h-9 bg-white border-b border-gray-200/80 shrink-0">
    <span class="text-[10px] font-semibold text-gray-400 uppercase tracking-wide px-1.5">Example</span>

    <div class="relative">
      <button
        @click="pickerOpen ? pickerOpen = false : openPicker()"
        class="flex items-center gap-1.5 px-2.5 py-1 bg-gray-100 hover:bg-gray-200/70 rounded-md text-xs text-gray-700"
      >
        <span x-text="currentExampleLabel"></span>
        <span class="text-gray-400 text-[9px] transition-transform" :class="pickerOpen ? 'rotate-180' : ''">&#9660;</span>
      </button>

      <div
        x-show="pickerOpen"
        x-cloak
        @click.outside="pickerOpen = false"
        @keydown.escape.window="pickerOpen = false"
        class="absolute left-0 top-full mt-1.5 w-80 bg-white rounded-xl shadow-xl border border-gray-200 z-50 overflow-hidden"
      >
        <input
          x-ref="pickerSearch"
          x-model="pickerQuery"
          type="text"
          placeholder="Search examples…"
          class="w-full px-3 py-2.5 text-sm border-b border-gray-100 focus:outline-none placeholder:text-gray-300"
          autocomplete="off"
          spellcheck="false"
        />
        <div class="max-h-80 overflow-y-auto py-1">
          <template x-for="group in filteredExampleGroups" :key="group.group">
            <div>
              <div class="px-3 pt-2 pb-0.5 text-[10px] uppercase tracking-wide text-gray-400 font-semibold" x-text="group.group"></div>
              <template x-for="ex in group.items" :key="ex.file">
                <button
                  @click="pickExample(ex.file)"
                  class="w-full text-left px-3 py-1.5 hover:bg-blue-50"
                  :class="activeExample === ex.file ? 'bg-blue-50/70' : ''"
                >
                  <span class="block text-sm" :class="activeExample === ex.file ? 'text-blue-700 font-medium' : 'text-gray-800'" x-text="ex.label"></span>
                  <span class="block text-[11px] text-gray-400" x-text="ex.hint"></span>
                </button>
              </template>
            </div>
          </template>
          <div x-show="filteredExampleGroups.length === 0" class="px-3 py-5 text-center text-xs text-gray-400">
            Nothing found
          </div>
        </div>
      </div>
    </div>

    <span
      x-show="errorCount > 0"
      x-cloak
      class="ml-auto mr-1 text-xs text-red-600 bg-red-50 rounded-md px-2 py-0.5 font-mono"
      x-text="errorCount + ' error' + (errorCount === 1 ? '' : 's')"
    ></span>
  </div>
  <div id="code-editor" class="flex-1 min-h-0"></div>
</div>
