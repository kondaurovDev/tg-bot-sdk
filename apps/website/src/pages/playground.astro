---
import "../playground/styles.css"

import PlaygroundHeader from "../components/PlaygroundHeader.astro"
import PlaygroundEditor from "../components/PlaygroundEditor.astro"
import PlaygroundModals from "../components/PlaygroundModals.astro"
import PlaygroundToasts from "../components/PlaygroundToasts.astro"
import PlaygroundChat from "../components/PlaygroundChat.astro"
import PlaygroundRealMode from "../components/PlaygroundRealMode.astro"
import PlaygroundLogs from "../components/PlaygroundLogs.astro"
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Write and run your Telegram bot code in TypeScript directly in your browser."
    />
    <meta property="og:title" content="Telegram Bot Playground | Telegram Bot SDK" />
    <meta property="og:description" content="Write and run your Telegram bot code in TypeScript directly in your browser." />
    <meta property="og:image" content="https://tg-bot-sdk.website/og-banner.png" />
    <meta property="og:url" content="https://tg-bot-sdk.website/playground/" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://tg-bot-sdk.website/playground/" />
    <title>Telegram Bot Playground | Telegram Bot SDK</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-slate-50 flex flex-col h-screen overflow-hidden">
    <div x-data="playground" @keydown.window.meta.enter.prevent="runIfReady()" @keydown.window.ctrl.enter.prevent="runIfReady()" class="flex flex-col h-full">

      <PlaygroundHeader />
      <PlaygroundModals />
      <PlaygroundToasts />

      <main
        x-ref="mainContainer"
        class="flex flex-1 min-h-0"
        :class="isDragging ? 'select-none' : ''"
      >
        <PlaygroundEditor />

        <div
          class="panel-divider"
          :class="isDragging ? 'dragging' : ''"
          @mousedown="startDrag($event)"
        ></div>

        <div class="flex-1 min-w-[280px] flex flex-col bg-gradient-to-b from-slate-100 to-slate-200">
          <PlaygroundChat />
          <PlaygroundRealMode />
          <PlaygroundLogs />
        </div>
      </main>

    </div>
  </body>
</html>
